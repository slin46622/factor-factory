# ── LLM（任一 OpenAI 兼容端点：DeepSeek / 智谱 GLM / OpenAI / 本地 vLLM ...）──
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com          # 例: https://open.bigmodel.cn/api/paas/v4
LLM_MODEL_QUICK=deepseek-chat                  # 批量挖掘用（快、便宜）
LLM_MODEL_DEEP=deepseek-reasoner               # 方向设定/审计用（强）

# 兼容旧变量名（agent 会依次回退读取）：
# ZHIPU_API_KEY / GLM_API_KEY / DEEPSEEK_API_KEY / TRADINGAGENTS_LLM_BACKEND_URL
# QUICK_THINK_LLM / DEEP_THINK_LLM

# ── 数据（qlib A股日线，用户自备；默认兼容 qlib 生态位置）──
FF_DATA_DIR=~/.qlib/cn_data
FF_HOME=~/.factor_factory                      # 因子库/日志/控制文件的根目录

# ── 可选：LLM 端点需要出网代理时 ──
# HTTPS_PROXY=http://127.0.0.1:7890
